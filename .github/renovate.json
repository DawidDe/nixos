{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "docker:pinDigests"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OCI container images in Nix files",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^@:\"]+)(?::(?<currentValue>[^@\"]+))?(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group all container image updates together",
      "matchDatasources": ["docker"],
      "groupName": "container images"
    },
    {
      "description": "Automerge patch container updates",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}